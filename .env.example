# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Convites / e-mail / WhatsApp (v1.2.0) — todos OPCIONAIS ────
# APP_URL=                # URL pública do app (default: http://localhost:3000) — usada no link de aceite do convite
# SMTP_HOST=              # Sem SMTP_HOST o app não envia e-mail e mostra o link do convite para o admin copiar
# SMTP_PORT=587           # 587 (STARTTLS) ou 465 (SSL)
# SMTP_USER=              # Usuário SMTP (opcional para relays sem auth)
# SMTP_PASS=              # Senha SMTP
# SMTP_FROM=              # Remetente (default: SMTP_USER)
# Cloudflare Email Sending: SMTP_HOST=smtp.mx.cloudflare.net, SMTP_PORT=465,
# SMTP_USER=api_token, SMTP_PASS=<token restrito a Email Sending: Edit>,
# SMTP_FROM="reembolsa.ia <no-reply@oreembolsobot.app>".
# WHATSAPP_VERIFY_TOKEN=  # Token de verificação do webhook /api/webhooks/whatsapp (Meta for Developers)

# ── Agente WhatsApp (v1.5.0) — OPCIONAIS; sem elas o agente roda em modo log ─
# WHATSAPP_PROVIDER=evolution   # evolution (largada, D-010) | meta (futuro)
# EVOLUTION_API_URL=            # URL da Evolution API no stack separado (D-011), ex.: http://evolution:8080
# EVOLUTION_API_KEY=            # API key da instância Evolution
# EVOLUTION_INSTANCE=           # Nome da instância (ex.: reembolsa)
# WHATSAPP_WEBHOOK_SECRET=      # Se definido, o Evolution deve enviar o mesmo valor no header x-webhook-secret
# AGENT_WHATSAPP_NUMBER=        # Número do agente (só dígitos, ex.: 5511912345678) — usado no link wa.me do convite-isqueiro (v1.6.0)
# RECEITAWS_TOKEN=  # Consulta CNPJ na Receita (ReceitaWS) — sem ela o botão "Buscar na Receita" fica indisponível

# ── Webhook 360dialog (v1.13.0) — OPCIONAIS; sem o segredo, a rota fica 403 ──
# DIALOG_360_WEBHOOK_SECRET=  # Valor COMPLETO e literal do header Authorization configurado na conta 360dialog (campo "headers" do POST /v1/configs/webhook, ecoado de volta em todo POST ao webhook). Inclui o prefixo, se houver: se lá o header é "Authorization: Bearer abc123xyz", aqui é DIALOG_360_WEBHOOK_SECRET=Bearer abc123xyz (não só "abc123xyz"). Sem esta variável, /api/webhooks/360dialog fica fail-closed (403 sempre)
# DIALOG_360_API_KEY=         # Chave da 360dialog para envio de template; nunca versionar
# DIALOG_360_WELCOME_TEMPLATE=boas_vindas_reembolsa # Template ativo com 1 variável de corpo: nome
# DIALOG_360_WELCOME_TEMPLATE_LANGUAGE=pt_BR

# ── API interna da POC WhatsApp (WP-02) ─────────────────────────────────────
# WHATSAPP_SERVICE_API_TOKENS foi desativada; não aceita token global.
# Configure WHATSAPP_SERVICE_TENANT_TOKENS na seção de integração abaixo.

# ── OCR de visão (v1.8) — OPCIONAIS; sem elas fotos caem em revisão manual ──
# OCR_PROVIDER=visao        # heuristica (default, só XML/texto) | visao (fotos/PDF via IA)
# Por padrão Mistral é a 1ª tentativa. Para usar OpenAI primeiro, defina
# OCR_VISION_PROVIDER=openai. A outra integração continua como contingência.
# OPENAI_API_KEY=           # OpenAI — nunca versionar
# OCR_OPENAI_MODEL=gpt-4o-mini
# POLICY_PROVIDER=mistral   # Política: cascata Mistral -> OpenAI -> heurístico.
#                          # Mistral faz OCR do PDF/imagem + estrutura as regras; se
#                          # falhar ou faltar MISTRAL_API_KEY, tenta OpenAI e só então
#                          # o heurístico. Use POLICY_PROVIDER=openai para pular o Mistral.
# ── OCR local da política (v1.14) — OPCIONAL; microserviço PaddleOCR (services/paddle-ocr) ──
# Antes de qualquer IA paga (política E comprovante): texto nativo do PDF (grátis) → OCR local.
# OCR_LOCAL_URL=http://127.0.0.1:4191    # vazio = desligado; no compose: http://paddle-ocr:4191
# OCR_LOCAL_TOKEN=                       # mesmo valor de PADDLE_OCR_TOKEN no serviço (openssl rand -hex 32)
# OCR_LOCAL_TIMEOUT_MS=120000
# POLICY_OCR_URL / POLICY_OCR_TOKEN / POLICY_OCR_TIMEOUT_MS: alias aceitos (nomes anteriores).
# MISTRAL_API_KEY=          # nunca versionar
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_MODEL=mistral-medium-latest
# Arquiteto: OpenAI primário e OpenRouter como fallback; ambos sujeitos ao ledger da POC.
# POLICY_OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=       # nunca versionar
# Lista ordenada (fallback nativo do OpenRouter): tarefa simples, modelos baratos com JSON Schema estrito.
# POLICY_OPENROUTER_MODELS=openai/gpt-4o-mini,google/gemini-2.5-flash-lite,mistralai/mistral-small-3.2-24b-instruct,openrouter/free
# POLICY_OPENROUTER_MODEL=openrouter/free   # usado só quando a lista acima está vazia
# POLICY_OPENROUTER_MAX_OUTPUT_TOKENS=4000
# Artefato operacional privado: endpoints de IA e consumo real em janelas de 10 min.
# Sem estes caminhos, os arquivos ficam ao lado de POC_CALLS_LEDGER.
# POC_AI_USAGE_LEDGER=/caminho/privado/ai-usage.jsonl
# POC_AI_DASHBOARD_FILE=/caminho/privado/ai-dashboard.json
# Campo / Google Routes API (servidor; nunca usar prefixo VITE_).
GOOGLE_MAPS_API_KEY=
POC_MAPS_ENABLED=false

# Integração HTTP: JSON de [{"token":"<segredo de pelo menos 32 caracteres>","empresaId":123}].
# Sem valor padrão; configuração ausente/inválida fecha /api/v1/*.
# WHATSAPP_SERVICE_API_TOKENS é legado e não autentica mais esta superfície.
WHATSAPP_SERVICE_TENANT_TOKENS=
