# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Convites / e-mail / WhatsApp (v1.2.0) — todos OPCIONAIS ────
# APP_URL=                # URL pública do app (default: http://localhost:3000) — usada no link de aceite do convite
# SMTP_HOST=              # Sem SMTP_HOST o app não envia e-mail e mostra o link do convite para o admin copiar
# SMTP_PORT=587           # 587 (STARTTLS) ou 465 (SSL)
# SMTP_USER=              # Usuário SMTP (opcional para relays sem auth)
# SMTP_PASS=              # Senha SMTP
# SMTP_FROM=              # Remetente (default: SMTP_USER)
# WHATSAPP_VERIFY_TOKEN=  # Token de verificação do webhook /api/webhooks/whatsapp (Meta for Developers)

# ── Agente WhatsApp (v1.5.0) — OPCIONAIS; sem elas o agente roda em modo log ─
# WHATSAPP_PROVIDER=evolution   # evolution (largada, D-010) | meta (futuro)
# EVOLUTION_API_URL=            # URL da Evolution API no stack separado (D-011), ex.: http://evolution:8080
# EVOLUTION_API_KEY=            # API key da instância Evolution
# EVOLUTION_INSTANCE=           # Nome da instância (ex.: reembolsa)
# WHATSAPP_WEBHOOK_SECRET=      # Se definido, o Evolution deve enviar o mesmo valor no header x-webhook-secret
# AGENT_WHATSAPP_NUMBER=        # Número do agente (só dígitos, ex.: 5511912345678) — usado no link wa.me do convite-isqueiro (v1.6.0)
# RECEITAWS_TOKEN=  # Consulta CNPJ na Receita (ReceitaWS) — sem ela o botão "Buscar na Receita" fica indisponível

# ── OCR de visão (v1.7.0) — OPCIONAIS; sem elas fotos caem em revisão manual ─
# OCR_PROVIDER=visao        # heuristica (default, só XML/texto) | visao (fotos/PDF via IA)
# OPENAI_API_KEY=           # OpenAI — leitura de foto/PDF de nota (modelo abaixo)
# OCR_OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=           # Google Gemini — fallback se a OpenAI falhar
# OCR_GEMINI_MODEL=gemini-2.0-flash
