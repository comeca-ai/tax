# Copie para .env e ajuste — usado pelo docker compose
# Gere um segredo forte: openssl rand -base64 48
APP_SECRET=
APP_PORT=3000
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=taxengine
MYSQL_USER=tax
MYSQL_PASSWORD=

# ── Convites / e-mail / WhatsApp (v1.2.0) — todos OPCIONAIS ────
# APP_URL=                # URL pública do app — usada no link de aceite do convite (default: http://localhost:3000)
# SMTP_HOST=              # Sem SMTP_HOST o app não envia e-mail e mostra o link do convite para o admin copiar
# SMTP_PORT=587           # 587 (STARTTLS) ou 465 (SSL)
# SMTP_USER=              # Usuário SMTP (opcional para relays sem auth)
# SMTP_PASS=              # Senha SMTP
# SMTP_FROM=              # Remetente (default: SMTP_USER)
# WHATSAPP_VERIFY_TOKEN=  # Token de verificação do webhook /api/webhooks/whatsapp (Meta for Developers)
# RECEITAWS_TOKEN=  # Consulta CNPJ na Receita (ReceitaWS) — sem ela o botão "Buscar na Receita" fica indisponível

# ── Webhook 360dialog (v1.13.0) — OPCIONAIS; sem o segredo, a rota fica 403 ──
# DIALOG_360_WEBHOOK_SECRET=  # Valor COMPLETO e literal do header Authorization configurado na conta 360dialog (campo "headers" do POST /v1/configs/webhook, ecoado de volta em todo POST ao webhook). Inclui o prefixo, se houver: se lá o header é "Authorization: Bearer abc123xyz", aqui é DIALOG_360_WEBHOOK_SECRET=Bearer abc123xyz (não só "abc123xyz"). Sem esta variável, /api/webhooks/360dialog fica fail-closed (403 sempre)
# DIALOG_360_API_KEY=         # Reservada para uso futuro (envio); não consumida por este webhook
